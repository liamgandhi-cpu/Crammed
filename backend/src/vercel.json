{
  "version": 2,
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node",
      "config": { "maxDuration": 300 }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "src/index.ts" }
  ],
  "crons": [
    {
      "path": "/api/push/send-reminders",
      "schedule": "0 13 * * *"
    }
  ]
}
