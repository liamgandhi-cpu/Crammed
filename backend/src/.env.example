PORT=4000
DATABASE_URL=postgresql://user:password@host:5432/autoplanner
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=32-byte-hex-string-for-aes-256
FRONTEND_URL=https://your-app.vercel.app

# Google sign-in: the OAuth 2.0 Web client ID from Google Cloud Console.
# MUST match the frontend's VITE_GOOGLE_CLIENT_ID. The backend rejects any
# Google access token that was not issued to this exact client ID, so leaving
# it unset disables Google sign-in entirely (fail closed).
GOOGLE_CLIENT_ID=000000000000-yourclientid.apps.googleusercontent.com

# ── AI (required) ──────────────────────────────────────────
# Read implicitly by `new Anthropic()` — it is never referenced by name in our
# code, which makes its absence easy to miss. Without it, daily-plan generation,
# schedule parsing and file import all fail.
ANTHROPIC_API_KEY=sk-ant-...

# ── Web push (optional; notifications are skipped without it) ──
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Email (optional; also read implicitly by the resend SDK) ──
RESEND_API_KEY=
RESEND_FROM=AutoPlanner <noreply@yourdomain.com>

# ── Ion / TJHSST integration (optional) ────────────────────
ION_CLIENT_ID=
ION_CLIENT_SECRET=

# ── Scheduled jobs ─────────────────────────────────────────
# Shared secret guarding POST /api/push/send-reminders, which Vercel cron calls.
CRON_SECRET=change-me-to-a-long-random-string

# ── Local single-process mode (optional) ───────────────────
# SERVE_STATIC=1 makes this server also serve frontend/src/dist, so the whole
# app runs on one port. Never set in production — the frontend deploys
# separately there. Requires `npm run build` in frontend/src first, and this
# origin (e.g. http://localhost:4000) must be in FRONTEND_URL.
# SERVE_STATIC=1

# Optional: path to local Chrome (macOS default shown)
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Vercel/serverless: URL to the Sparticuz chromium pack
# CHROMIUM_PACK_URL=https://github.com/Sparticuz/chromium/releases/download/v133.0.0/chromium-v133.0.0-pack.tar
