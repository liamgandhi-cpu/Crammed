PORT=4000
DATABASE_URL=postgresql://user:password@host:5432/autoplanner
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=32-byte-hex-string-for-aes-256
FRONTEND_URL=https://your-app.vercel.app

# Google sign-in: the OAuth 2.0 Web client ID from Google Cloud Console.
# MUST match the frontend's VITE_GOOGLE_CLIENT_ID. The backend rejects any
# Google access token that was not issued to this exact client ID, so leaving
# it unset disables Google sign-in entirely (fail closed).
GOOGLE_CLIENT_ID=000000000000-yourclientid.apps.googleusercontent.com

# Optional: path to local Chrome (macOS default shown)
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Vercel/serverless: URL to the Sparticuz chromium pack
# CHROMIUM_PACK_URL=https://github.com/Sparticuz/chromium/releases/download/v133.0.0/chromium-v133.0.0-pack.tar
