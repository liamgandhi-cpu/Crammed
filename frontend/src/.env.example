# URL of your deployed backend (leave empty to use Vite proxy in dev)
VITE_API_URL=https://your-backend.vercel.app

# Google sign-in: the OAuth 2.0 Web client ID from Google Cloud Console.
# MUST be identical to the backend's GOOGLE_CLIENT_ID — the backend rejects
# any Google token not issued to that exact client, so a mismatch fails every
# sign-in with an opaque 401 (the real reason is in the server log).
# Authorized JavaScript origins must include every origin you serve from,
# e.g. http://localhost:5173 (vite dev) and http://localhost:4000 (SERVE_STATIC=1).
VITE_GOOGLE_CLIENT_ID=000000000000-yourclientid.apps.googleusercontent.com
